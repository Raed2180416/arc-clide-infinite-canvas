{
  "name": "arc-clide-repository-atlas",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A provenance-aware, multi-resolution repository atlas for humans and coding agents.",
  "scripts": {
    "test": "npm run test:node && npm run test:web",
    "test:node": "node --test tests/*.test.mjs",
    "test:web": "vitest run",
    "build:web": "vite build",
    "build:pages": "node bin/build-public-pages.mjs",
    "dev": "vite",
    "atlas": "node bin/atlas.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "elkjs": "^0.12.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "typescript": "^6.0.3",
    "web-tree-sitter": "0.26.9",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "tree-sitter-ql": "1.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
